# Copy this file to `.env` on the server and fill in the values.

# Long random string. Leave empty to auto-generate one into .secret_key
DJANGO_SECRET_KEY=

# Never True during the real event
DJANGO_DEBUG=False

# Server IP and/or domain name, comma separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR.SERVER.IP,contest.example.com

# Full URLs (with scheme and port) that students open in the browser
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR.SERVER.IP:8000,https://contest.example.com

# True only if the site is served over HTTPS (e.g. nginx + TLS in front)
DJANGO_USE_HTTPS=False

DJANGO_TIME_ZONE=Africa/Cairo

# Path of the Django admin panel (keep it private), e.g. https://site/psc-control/
DJANGO_ADMIN_PATH=psc-control/

# Max student programs running at once (default: number of CPU cores)
# JUDGE_CONCURRENCY=4

# Seconds between submissions from the same group
SUBMIT_COOLDOWN_SECONDS=5

# Only when the server runs behind a reverse proxy (nginx): its IP, e.g. 127.0.0.1
# TRUSTED_PROXY=127.0.0.1

# Used by `manage.py seed` when it creates the admin user on a fresh database
# ADMIN_PASSWORD=
